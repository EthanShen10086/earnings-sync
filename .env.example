# 复制为 .env 后填入。不要把真实密钥提交到仓库。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 执行模型要能调用工具。deepseek-chat / deepseek-reasoner 已在 2026-07-24 退役。
# deepseek-flash 负责工具循环；更难的财报判断可改成 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-flash

# 飞书群 → 设置 → 群机器人 → 自定义机器人。签名校验打开后，两个值要来自同一个机器人。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 把 JSON 文件放到本机只有你能读的位置，例如 ~/.config/earnings-sync/sheets.json，然后执行 chmod 600 该文件。
GOOGLE_APPLICATION_CREDENTIALS=

# 新建表格时，程序把编辑权授给你自己。等号右边写登录 https://docs.google.com 时右上角头像里的邮箱。
# 不要填服务账号 JSON 里的 client_email。等号两边不要空格，不要加引号。步骤见 docs/connect.md 第 4 节。
GOOGLE_SHARE_WITH=

# 留空则不导出 trace，服务仍可运行。本地 Jaeger 用 http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# SEC 要求带联系方式的 User-Agent
SEC_USER_AGENT=earnings-sync/0.1 (research; you@example.com)

COMPANIES_FILE=configs/companies.yaml
JOB_STORE_PATH=data/jobs.json
