# 复制为 .env 后填入。不要把真实密钥提交到仓库。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 执行模型要能调用工具。deepseek-chat / deepseek-reasoner 已在 2026-07-24 退役。
# deepseek-flash 负责工具循环；更难的财报判断可改成 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-flash

# 飞书群 → 设置 → 群机器人 → 自定义机器人。签名校验打开后，两个值要来自同一个机器人。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 把 JSON 文件放到本机只有你能读的位置，例如 ~/.config/earnings-sync/sheets.json，然后执行 chmod 600 该文件。
GOOGLE_APPLICATION_CREDENTIALS=

# 新建表格时，程序把编辑权授给你自己。等号右边写登录 https://docs.google.com 时右上角头像里的邮箱。
# 不要填服务账号 JSON 里的 client_email。等号两边不要空格，不要加引号。步骤见 docs/connect.md 第 4 节。
GOOGLE_SHARE_WITH=

# 留空则不导出 trace，服务仍可运行。本地 Jaeger 用 http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# IAM / SSO。默认 bypass：无 IdP 密钥可演示。OIDC 可用 JWT 形 stub（见 docs/stub-credentials.md）
AUTH_MODE=bypass
AUTH_DEV_SUBJECT=dev-user
AUTH_DEV_EMAIL=dev@localhost
AUTH_DEV_NAME=Dev Bypass
AUTH_DEV_ROLES=admin,reader
AUTH_DEV_TENANT=local
AUTH_BEARER_TOKEN=
# AUTH_MODE=oidc 时：Bearer 为 header.payload.sig；校验 sub/iss/aud，不验签
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_AUDIENCE=

# SEC 要求带联系方式的 User-Agent
SEC_USER_AGENT=earnings-sync/0.1 (research; you@example.com)

COMPANIES_FILE=configs/companies.yaml
# 无 DATABASE_URL 时 jobs 落此文件；有 DATABASE_URL 时走 PostgreSQL（jobs / flow_runs）
JOB_STORE_PATH=data/jobs.json

# 存储：sheets-only（默认）| pg-only | dual。无 Google 密钥时 Sheets 侧用 Memory。
STORAGE_MODE=sheets-only
# 双写失败策略：all（默认，遇错即停）| partial（两侧都试）
STORAGE_FAIL_POLICY=all
# PostgreSQL（docker compose -f deploy/docker-compose.yml up -d postgres）
# 同时用于事实双写 + jobs/runs 跨进程幂等（见 docs/jobs-runs-pg.md）
DATABASE_URL=
# 可选；默认从工作目录向上查找 migrations/
MIGRATIONS_DIR=

# --- 可插拔高级能力（默认 off / auto）见 docs/feature-flags.md / docs/stub-credentials.md ---
# flag=1 且无远程依赖 → 可运行 Memory/文件 stub（非空 noop）；flag=0 → noop
FEATURE_REDIS=0
FEATURE_MQ=0
FEATURE_KAFKA=0
FEATURE_OBJECT_STORAGE=0
FEATURE_AUDIT=0
FEATURE_SEARCH=0
FEATURE_DISCOVERY=0
FEATURE_ELK=0
FEATURE_NOTIFY=auto
FEATURE_LLM=auto
FEATURE_SHEETS_GOOGLE=auto
FEATURE_OTEL=auto
# 可留空：空则 stub；有值则 infra 尝试拨号，失败且 INFRA_STRICT=false 仍 stub
REDIS_URL=
MQ_URL=
KAFKA_BROKERS=
KAFKA_EVENT_LOG=data/kafka-events.jsonl
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# 服务发现：memory | nacos | consul | eureka；URL 空则内存注册表
DISCOVERY_BACKEND=memory
DISCOVERY_URL=
# ELK：文件 shipper 默认开在 infra；FEATURE_ELK=1 时 ingest 写日志；ES 可空
LOG_SHIPPER_PATH=data/logs/app.jsonl
ELASTICSEARCH_URL=
ALERT_RULES_PATH=deploy/alert-rules.yml

# --- 数据面接线（adapters + deploy；缺省降级，见 docs/infra.md）---
# NATS 占位（compose --profile mq）；MQ 优先 Redis Streams（REDIS_URL）
NATS_URL=
# 本地对象存储目录 + CDN URL 改写占位（compose --profile objects 起 MinIO，尚未接 S3 SDK）
OBJECT_STORE_DIR=data/objects
CDN_BASE_URL=
# 审计 / 搜索 stub（有 DATABASE_URL 且可连时优先 PG 表，否则文件）
AUDIT_LOG_PATH=data/audit.jsonl
SEARCH_INDEX_PATH=data/search
# API 网关限流骨架；0 = 关闭
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=20
# true 时 Redis/NATS/PG 配置了却连不上则启动失败
INFRA_STRICT=false
