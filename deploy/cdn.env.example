# CDN / object delivery placeholders (copy values into .env as needed).
# The app only rewrites object URLs with CDN_BASE_URL; no edge cache is provisioned.

CDN_BASE_URL=https://cdn.example.com
OBJECT_STORE_DIR=data/objects

# Future S3-compatible (compose profile "objects" runs MinIO):
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=earnings
# S3_ACCESS_KEY=earnings
# S3_SECRET_KEY=earningsdev
